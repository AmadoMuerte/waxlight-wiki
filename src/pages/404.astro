---
// Custom Waxlight 404 page.
// Also redirects legacy Wiki URLs (old /en/... and *.html paths) to their new
// locations, preserving traffic and SEO equity during migration.
const pathname = Astro.url.pathname;
const isRu = pathname.startsWith('/waxlight-wiki/ru/') || pathname.startsWith('/waxlight-wiki/ru');
const t = isRu
	? {
			title: 'Страница не найдена',
			text: 'Страница, которую вы ищете, не существует, была перемещена или переименована.',
			home: 'На главную вики',
			search: 'Поиск по вики',
		}
	: {
			title: 'Page not found',
			text: 'The page you are looking for does not exist, was moved, or was renamed.',
			home: 'Go to the wiki home',
			search: 'Search the wiki',
		};
const home = isRu ? '/waxlight-wiki/ru/' : '/waxlight-wiki/en/';
const htmlLang = isRu ? 'ru' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{t.title} | Waxlight Wiki</title>
		<link rel="icon" href="/waxlight-wiki/waxlight.png" />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				color: #f1dfbd;
				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					'Segoe UI',
					sans-serif;
				background:
					radial-gradient(circle at 12% 0%, rgba(145, 94, 43, 0.18), transparent 30rem),
					radial-gradient(circle at 95% 8%, rgba(93, 126, 73, 0.12), transparent 26rem),
					linear-gradient(180deg, #171310 0, #12100d 24rem, #090a09 100%);
				background-attachment: fixed;
				line-height: 1.65;
			}
			.wrap {
				max-width: 34rem;
				padding: 2rem;
				text-align: center;
			}
			img {
				width: 96px;
				height: 96px;
				border-radius: 16px;
				filter: drop-shadow(0 0 24px rgba(241, 189, 107, 0.45));
			}
			h1 {
				margin: 1.25rem 0 0.5rem;
				font-family: Georgia, 'Times New Roman', serif;
				font-size: clamp(2.25rem, 6vw, 3.5rem);
				font-weight: 500;
				letter-spacing: -0.03em;
			}
			h1 em {
				color: #f1bd6b;
				font-style: italic;
			}
			p {
				color: #c5b08b;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				justify-content: center;
				margin-top: 1.5rem;
			}
			a.btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 11px 18px;
				border: 1px solid rgba(241, 223, 189, 0.16);
				border-radius: 5px 14px 5px 14px;
				color: #f1dfbd;
				background: rgba(33, 25, 18, 0.78);
				font-weight: 800;
				font-size: 0.9rem;
				text-decoration: none;
			}
			a.btn:hover {
				border-color: rgba(217, 140, 67, 0.48);
				background: #342519;
			}
			a.btn.primary {
				border-color: transparent;
				color: #25170b;
				background: linear-gradient(135deg, #d98c43, #f1bd6b);
			}
			.redirecting {
				margin-top: 1.5rem;
				color: #b8ad98;
				font-size: 0.85rem;
			}
		</style>
	</head>
	<body>
		<main class="wrap">
			<img src="/waxlight-wiki/waxlight.png" alt="Waxlight logo" width="96" height="96" />
			<h1>404 — <em>{t.title}</em></h1>
			<p>{t.text}</p>
			<div class="actions">
				<a class="btn primary" href={home}>{t.home}</a>
				<a class="btn" href={isRu ? '/waxlight-wiki/ru/' : '/waxlight-wiki/en/'} data-search>
					{t.search}
				</a>
			</div>
			<p class="redirecting" hidden>Looking like an old Waxlight Wiki link — redirecting…</p>
		</main>
		<script>
			// Legacy URL mapping: old wiki pages lived at /en/<path>.html and
			// /ru/<path>.html (or bare .html suffixes). Map them to the new routes.
			const BASE = '/waxlight-wiki';
			const OLD_PAGES: Record<string, number> = {
				'getting-started': 1,
				faq: 1,
				documents: 1,
				development: 1,
				'features/accounts': 1,
				'features/game-versions': 1,
				'features/instances': 1,
				'features/mods': 1,
				'features/backups': 1,
				'features/packages': 1,
				'features/operations': 1,
				'features/updates': 1,
				'policies/privacy': 1,
				'policies/security': 1,
				'policies/code-signing': 1,
			};
			if (/\/(en|ru)\//.test(location.pathname) || /\.html/.test(location.pathname)) {
				const lang = location.pathname.includes('/ru/') ? 'ru' : 'en';
				const slug = location.pathname
					.replace(/^.*?\/(?:en|ru)\//, '')
					.replace(/\.html?$/, '')
					.replace(/\/$/, '')
					.replace(/^index$/, '');
				if (slug === '' || OLD_PAGES[slug]) {
					location.replace(BASE + '/' + lang + '/' + slug + (slug ? '/' : ''));
				}
			}
		</script>
	</body>
</html>
