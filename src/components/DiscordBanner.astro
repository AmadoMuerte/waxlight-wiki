---
// Discord community banner, reproducing the original homepage banner.
const t = Astro.locals.t;
const invite = 'https://discord.gg/CrRHvg9UVw';
---

<div class="wax-banner">
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path
			d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.8 13.8 0 0 0-.64 1.28 18.3 18.3 0 0 0-5.5 0 13.8 13.8 0 0 0-.64-1.28c-1.71.29-3.37.8-4.93 1.51A20.3 20.3 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.3-2.1a12.9 12.9 0 0 1-2.05-.98c.17-.12.34-.25.5-.38a14.2 14.2 0 0 0 12.16 0c.16.13.33.26.5.38-.65.39-1.34.72-2.05.98.37.73.81 1.44 1.3 2.1a19.9 19.9 0 0 0 6.07-3.03 20.3 20.3 0 0 0-3.58-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Z"
		></path>
	</svg>
	<div>
		<h2>{t('waxlight.bannerTitle')}</h2>
		<p>{t('waxlight.bannerText')} <strong>{t('waxlight.discordInvite')}</strong></p>
	</div>
	<a class="sl-link-button wax-banner__join" href={invite} target="_blank" rel="noopener"
		>{t('waxlight.bannerJoin')}</a
	>
</div>
